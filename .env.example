# Neon Cloud PostgreSQL Connection String
# Replace with your actual Neon PostgreSQL connection URI, e.g.:
# DATABASE_URL=postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Leave blank to use a local SQLite file (local development only; required on Vercel)
DATABASE_URL=

# Admin Access Credentials (seeds the first admin user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password

# Long random string used to sign admin session cookies
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only needed for admin passwords hashed by older versions (they are upgraded on next login)
AUTH_SALT=
